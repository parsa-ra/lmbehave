+def _coerce_to_bool(value: Any) -> bool:
+    if isinstance(value, bool):
+        return value
+    if isinstance(value, str):
+        return value.strip().lower() in {"1", "true", "yes", "y", "on"}
+    return bool(value)
+
+
+def _normalize_layer_indices(layer_spec: Any, max_layers: int) -> set[int] | None:
+    if layer_spec is None:
+        return None
+    if isinstance(layer_spec, str):
+        normalized = layer_spec.strip().lower()
+        if normalized in {"", "all", "none"}:
+            return None
+        items = [item for item in normalized.replace(";", ",").replace(":", ",").split(",") if item]
+        parsed = [int(item) for item in items]
+    elif isinstance(layer_spec, int):
+        parsed = [layer_spec]
+    elif isinstance(layer_spec, (list, tuple, set)):
+        parsed = [int(item) for item in layer_spec]
+    else:
+        return None
+
+    filtered = {idx for idx in parsed if 0 <= idx < max_layers}
+    return filtered if filtered else None
+
+
+def _update_vt_attn_collector(
+    collector: dict[str, Any] | None,
+    layer_idx: int,
+    query_states: torch.Tensor,
+    key_states: torch.Tensor,
+    visual_pos_masks: torch.Tensor | None,
+    token_mask: torch.Tensor | None,
+    scaling: float,
+) -> None:
+    if collector is None or visual_pos_masks is None:
+        return
+
+    target_layers = collector.get("layers")
+    if target_layers is not None and layer_idx not in target_layers:
+        return
+
+    if visual_pos_masks.ndim != 2 or visual_pos_masks.shape[0] != query_states.shape[0]:
+        return
+
+    if visual_pos_masks.shape[-1] != query_states.shape[-2]:
+        # Happens during decode steps (query length == 1) when using KV cache.
+        return
+
+    records = collector.setdefault("records", {})
+    layer_record = records.setdefault(
+        layer_idx,
+        {
+            "means": {name: [] for name in ("t2v", "v2t", "v2v", "t2t")},
+            "token_scores": {name: [] for name in ("t2v", "v2t", "v2v", "t2t")},
+            "visual_importance": [],
+        },
+    )
+
+    batch_size = query_states.shape[0]
+    seq_len = query_states.shape[-2]
+    for batch_idx in range(batch_size):
+        if token_mask is None:
+            valid_mask = torch.ones(seq_len, dtype=torch.bool, device=query_states.device)
+        else:
+            valid_mask = token_mask[batch_idx].to(dtype=torch.bool, device=query_states.device)
+            if valid_mask.shape[-1] != seq_len:
+                continue
+
+        visual_mask = visual_pos_masks[batch_idx].to(dtype=torch.bool, device=query_states.device) & valid_mask
+        text_mask = (~visual_pos_masks[batch_idx].to(dtype=torch.bool, device=query_states.device)) & valid_mask
+
+        if not torch.any(visual_mask) or not torch.any(text_mask):
+            continue
+
+        # Use averaged query vectors for each token type to avoid materializing full attention matrices.
+        query_batch = query_states[batch_idx].float()
+        key_batch = key_states[batch_idx].float()
+        if key_batch.shape[0] != query_batch.shape[0]:
+            if query_batch.shape[0] % key_batch.shape[0] != 0:
+                continue
+            repeat_factor = query_batch.shape[0] // key_batch.shape[0]
+            key_batch = (
+                key_batch[:, None, :, :]
+                .expand(key_batch.shape[0], repeat_factor, key_batch.shape[1], key_batch.shape[2])
+                .reshape(query_batch.shape[0], key_batch.shape[1], key_batch.shape[2])
+            )
+
+        q_text = query_batch[:, text_mask, :].mean(dim=1)
+        q_visual = query_batch[:, visual_mask, :].mean(dim=1)
+        k_text = key_batch[:, text_mask, :]
+        k_visual = key_batch[:, visual_mask, :]
+
+        t2v = (k_visual * q_text.unsqueeze(1)).sum(dim=-1).mean(dim=0) * scaling
+        v2t = (k_text * q_visual.unsqueeze(1)).sum(dim=-1).mean(dim=0) * scaling
+        v2v = (k_visual * q_visual.unsqueeze(1)).sum(dim=-1).mean(dim=0) * scaling
+        t2t = (k_text * q_text.unsqueeze(1)).sum(dim=-1).mean(dim=0) * scaling
+
+        score_map = {"t2v": t2v, "v2t": v2t, "v2v": v2v, "t2t": t2t}
+        for score_name, score_tensor in score_map.items():
+            layer_record["means"][score_name].append(float(score_tensor.mean().item()))
+            if collector.get("store_token_scores", True):
+                layer_record["token_scores"][score_name].append(score_tensor.detach().cpu())
+
+        if collector.get("collect_visual_importance", False):
+            dense_importance = torch.full((seq_len,), float("-inf"), dtype=torch.float32, device=query_states.device)
+            dense_importance[visual_mask] = t2v
+            layer_record["visual_importance"].append(dense_importance.detach().cpu())
