+def _compute_vision_key_importance(
+    query_states: torch.Tensor,
+    key_states: torch.Tensor,
+    cu_seqlens: torch.Tensor,
+    scaling: float,
+    query_chunk_size: int = 64,
+) -> torch.Tensor:
+    token_scores = []
+    offset = 0
+    lengths = (cu_seqlens[1:] - cu_seqlens[:-1]).tolist()
+    for length in lengths:
+        local_length = int(length)
+        if local_length <= 0:
+            continue
+        local_q = query_states[0, :, offset : offset + local_length, :]
+        local_k = key_states[0, :, offset : offset + local_length, :]
+        local_k_t = local_k.transpose(1, 2)
+        step = max(1, min(int(query_chunk_size), local_length))
+        score_accum = torch.zeros(
+            (local_q.shape[0], local_length), dtype=torch.float32, device=query_states.device
+        )
+        seen_queries = 0
+
+        for start in range(0, local_length, step):
+            end = min(start + step, local_length)
+            q_chunk = local_q[:, start:end, :]
+            logits = torch.matmul(q_chunk, local_k_t) * scaling
+            probs = torch.softmax(logits.float(), dim=-1)
+            score_accum += probs.sum(dim=1)
+            seen_queries += end - start
+
+        # Per-key importance = average attention mass received across heads and all queries.
+        score = (score_accum / max(1, seen_queries)).mean(dim=0)
+        token_scores.append(score)
+        offset += local_length
+
+    if not token_scores:
+        return torch.empty(0, device=query_states.device, dtype=torch.float32)
+    return torch.cat(token_scores, dim=0)
+
