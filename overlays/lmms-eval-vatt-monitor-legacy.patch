diff --git a/lmms_eval/models/model_utils/vt_attention_monitor.py b/lmms_eval/models/model_utils/vt_attention_monitor.py
new file mode 100644
index 0000000000000000000000000000000000000000..4e2c850c149935ee57c06b1147f9d93be0b64a23
--- /dev/null
+++ b/lmms_eval/models/model_utils/vt_attention_monitor.py
@@ -0,0 +1,194 @@
+import json
+import os
+import time
+from collections import defaultdict
+from typing import Any
+
+import numpy as np
+from loguru import logger as eval_logger
+
+try:
+    import matplotlib.pyplot as plt
+except Exception:
+    plt = None
+
+
+class VisualTextAttentionMonitor:
+    def __init__(
+        self,
+        out_dir: str,
+        bins: int = 80,
+        enable_plots: bool = True,
+        file_prefix: str = "vt_attention",
+    ) -> None:
+        self.out_dir = out_dir
+        self.bins = int(max(10, bins))
+        self.enable_plots = bool(enable_plots)
+        self.file_prefix = file_prefix
+        self._score_names = ("t2v", "v2t", "v2v", "t2t")
+        self._token_scores = {name: [] for name in self._score_names}
+        self._layer_means = defaultdict(lambda: {name: [] for name in self._score_names})
+        self._updates = 0
+
+    def update(self, collector: dict[str, Any] | None) -> None:
+        if not collector:
+            return
+        records = collector.get("records", {})
+        if not records:
+            return
+        self._updates += 1
+
+        for layer_idx, layer_data in records.items():
+            layer_int = int(layer_idx)
+            means = layer_data.get("means", {})
+            for score_name in self._score_names:
+                if score_name in means:
+                    self._layer_means[layer_int][score_name].extend(float(v) for v in means[score_name])
+
+            token_scores = layer_data.get("token_scores", {})
+            for score_name in self._score_names:
+                if score_name not in token_scores:
+                    continue
+                for values in token_scores[score_name]:
+                    if hasattr(values, "detach"):
+                        values = values.detach().cpu().numpy()
+                    arr = np.asarray(values, dtype=np.float32).reshape(-1)
+                    if arr.size > 0:
+                        self._token_scores[score_name].append(arr)
+
+    def has_data(self) -> bool:
+        return any(len(values) > 0 for values in self._token_scores.values())
+
+    def finalize(self, run_name: str | None = None) -> dict[str, str] | None:
+        if not self.has_data():
+            return None
+
+        os.makedirs(self.out_dir, exist_ok=True)
+        run_suffix = run_name or time.strftime("%Y%m%d_%H%M%S")
+        base_name = f"{self.file_prefix}_{run_suffix}"
+
+        stacked_scores = {}
+        for score_name in self._score_names:
+            if self._token_scores[score_name]:
+                stacked_scores[score_name] = np.concatenate(self._token_scores[score_name], axis=0)
+            else:
+                stacked_scores[score_name] = np.array([], dtype=np.float32)
+
+        summary = {}
+        for score_name, values in stacked_scores.items():
+            if values.size == 0:
+                summary[score_name] = {"count": 0}
+                continue
+            summary[score_name] = {
+                "count": int(values.size),
+                "mean": float(values.mean()),
+                "std": float(values.std()),
+                "min": float(values.min()),
+                "p05": float(np.percentile(values, 5)),
+                "p50": float(np.percentile(values, 50)),
+                "p95": float(np.percentile(values, 95)),
+                "max": float(values.max()),
+            }
+
+        layer_means = {}
+        for layer_idx, means_by_score in sorted(self._layer_means.items(), key=lambda x: x[0]):
+            layer_means[str(layer_idx)] = {}
+            for score_name in self._score_names:
+                values = means_by_score[score_name]
+                if values:
+                    layer_means[str(layer_idx)][score_name] = {
+                        "count": len(values),
+                        "mean": float(np.mean(values)),
+                        "std": float(np.std(values)),
+                    }
+                else:
+                    layer_means[str(layer_idx)][score_name] = {"count": 0}
+
+        payload = {
+            "num_updates": self._updates,
+            "summary": summary,
+            "layer_means": layer_means,
+        }
+
+        json_path = os.path.join(self.out_dir, f"{base_name}.json")
+        with open(json_path, "w", encoding="utf-8") as f:
+            json.dump(payload, f, indent=2)
+
+        artifacts = {"json": json_path}
+        if self.enable_plots and plt is not None:
+            hist_path = self._plot_histograms(stacked_scores, base_name)
+            if hist_path:
+                artifacts["hist"] = hist_path
+            layers_path = self._plot_layer_means(base_name)
+            if layers_path:
+                artifacts["layers"] = layers_path
+        elif self.enable_plots and plt is None:
+            eval_logger.warning("matplotlib is not available; skipped VT attention plots.")
+
+        self.reset()
+        return artifacts
+
+    def reset(self) -> None:
+        self._token_scores = {name: [] for name in self._score_names}
+        self._layer_means = defaultdict(lambda: {name: [] for name in self._score_names})
+        self._updates = 0
+
+    def _plot_histograms(self, stacked_scores: dict[str, np.ndarray], base_name: str) -> str | None:
+        fig, axes = plt.subplots(2, 2, figsize=(11, 8))
+        axes = axes.flatten()
+        plotted = 0
+        for idx, score_name in enumerate(self._score_names):
+            values = stacked_scores[score_name]
+            ax = axes[idx]
+            if values.size == 0:
+                ax.set_title(f"{score_name} (empty)")
+                ax.axis("off")
+                continue
+            ax.hist(values, bins=self.bins, alpha=0.9, color="#1f77b4")
+            ax.set_title(score_name)
+            ax.set_xlabel("score")
+            ax.set_ylabel("count")
+            plotted += 1
+        if plotted == 0:
+            plt.close(fig)
+            return None
+        fig.tight_layout()
+        path = os.path.join(self.out_dir, f"{base_name}_hist.png")
+        fig.savefig(path, dpi=140)
+        plt.close(fig)
+        return path
+
+    def _plot_layer_means(self, base_name: str) -> str | None:
+        if not self._layer_means:
+            return None
+
+        layer_ids = sorted(self._layer_means.keys())
+        fig, ax = plt.subplots(figsize=(10, 5))
+        plotted = 0
+        for score_name in self._score_names:
+            y = []
+            x = []
+            for layer_idx in layer_ids:
+                values = self._layer_means[layer_idx][score_name]
+                if not values:
+                    continue
+                x.append(layer_idx)
+                y.append(float(np.mean(values)))
+            if y:
+                ax.plot(x, y, marker="o", linewidth=1.5, label=score_name)
+                plotted += 1
+
+        if plotted == 0:
+            plt.close(fig)
+            return None
+
+        ax.set_xlabel("layer")
+        ax.set_ylabel("mean score")
+        ax.set_title("Visual/Text Attention Mean by Layer")
+        ax.grid(alpha=0.25)
+        ax.legend()
+        fig.tight_layout()
+        path = os.path.join(self.out_dir, f"{base_name}_layer_means.png")
+        fig.savefig(path, dpi=140)
+        plt.close(fig)
+        return path
